# Dev environment variable values
# Auth0 credentials are injected via GitHub Actions secrets — do NOT put real values here
environment = "dev"

# These will be overridden by CI/CD environment variables:
# auth0_domain        = from secret AUTH0_DEV_DOMAIN
# auth0_client_id     = from secret AUTH0_DEV_CLIENT_ID
# auth0_client_secret = from secret AUTH0_DEV_CLIENT_SECRET
